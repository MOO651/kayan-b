generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: for local development with SQLite, temporarily switch provider to
// "sqlite" and DATABASE_URL="file:./dev.db", then run: npm run db:setup

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("EDITOR") // ADMIN | EDITOR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id        String                @id @default(cuid())
  slug      String                @unique
  titleAr   String
  titleEn   String                @default("")
  excerptAr String                @default("")
  excerptEn String                @default("")
  contentAr String                @default("")
  contentEn String                @default("")
  icon      String                @default("")
  image     String                @default("")
  order     Int                   @default(0)
  published Boolean               @default(true)
  requests  ConsultationRequest[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model Lawyer {
  id           String   @id @default(cuid())
  slug         String?  @unique
  nameAr       String
  nameEn       String   @default("")
  titleAr      String   @default("")
  titleEn      String   @default("")
  bioAr        String   @default("")
  bioEn        String   @default("")
  photo        String   @default("")
  specialties  String   @default("")
  email        String   @default("")
  phone        String   @default("")
  linkedin     String   @default("")
  order        Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  nameAr   String
  nameEn   String    @default("")
  articles Article[]
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleAr     String
  titleEn     String    @default("")
  excerptAr   String    @default("")
  excerptEn   String    @default("")
  contentAr   String    @default("")
  contentEn   String    @default("")
  image       String    @default("")
  seoTitleAr  String    @default("")
  seoTitleEn  String    @default("")
  seoDescAr   String    @default("")
  seoDescEn   String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ConsultationRequest {
  id               String   @id @default(cuid())
  name             String
  phone            String
  email            String   @default("")
  serviceId        String?
  service          Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  message          String
  preferredContact String   @default("phone") // phone | email | whatsapp
  status           String   @default("NEW") // NEW | IN_PROGRESS | CLOSED
  notes            String   @default("")
  attachmentName   String   @default("")
  attachmentMime   String   @default("")
  attachmentData   Bytes?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  path      String   @unique
  mime      String
  size      Int
  alt       String   @default("")
  createdAt DateTime @default(now())
}

model Faq {
  id        String   @id @default(cuid())
  questionAr String
  questionEn String  @default("")
  answerAr   String
  answerEn   String  @default("")
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  roleAr    String   @default("")
  roleEn    String   @default("")
  contentAr String
  contentEn String   @default("")
  rating    Int      @default(5)
  photo     String   @default("")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioItem {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String   @default("")
  summaryAr   String   @default("")
  summaryEn   String   @default("")
  outcomeAr   String   @default("")
  outcomeEn   String   @default("")
  image       String   @default("")
  tags        String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
